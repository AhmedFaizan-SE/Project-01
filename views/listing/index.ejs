<% layout("layout/boilerplate") %>
<body>
    <h3>All Listing Title</h3>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let list of allListings){%>
        <a href="/listings/<%=list._id %>" class="listing-link">
    <div class="card">
<img src="<%= list.image %>" class="card-img-top" alt="<%= list.title %>" style="width: 100%; height: 220px; object-fit: cover;">
<div class="card-img-overlay"> </div> 
<div class="card-body">
    <p class="card-text">
       <b> <%= list.title %> </b> <br>
        $<%= list.price.toLocaleString()%> / Night

    </p>
  </div>
</div>   </a><%}%>
</div>

</body>
